# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cv_app:CHANGE_ME@localhost:5432/cv_analyzer_prod
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=cv_analyzer

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Password ──────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=9
BCRYPT_ROUNDS=10

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=mail.ai970.cloud
SMTP_PORT=587
SMTP_USER=noreply@ai970.cloud
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@ai970.cloud
EMAIL_FROM_NAME=CV Analyzer

# ── IMAP (CV intake) ──────────────────────────────────────────────────────────
IMAP_HOST=mail.ai970.cloud
IMAP_PORT=993
IMAP_USER=jobs@ai970.cloud
IMAP_PASSWORD=CHANGE_ME
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL=120

# ── File storage ──────────────────────────────────────────────────────────────
FILES_BASE_PATH=/files
MAX_FILE_SIZE_MB=10

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://app.ai970.cloud
API_BASE_URL=https://api.ai970.cloud

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.ai970.cloud"]

# ── LibreOffice ───────────────────────────────────────────────────────────────
LIBREOFFICE_BIN=soffice

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
