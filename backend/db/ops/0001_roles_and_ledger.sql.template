-- ops/0001_roles_and_ledger.sql.template
--
-- OPERATOR TEMPLATE. This is not a migration. The runner never reads this directory, and this change does not execute it
-- against any database except disposable test databases.
--
-- Run once per environment, as the bootstrap superuser, before the first non-fresh runner invocation.
-- Passwords are supplied as psql variables from the deployment secret store. None is written in this file.
--
--   psql -X -v ON_ERROR_STOP=1 \
--        -v migration_operator_password="$MIGRATION_OPERATOR_PASSWORD" \
--        -d "$DATABASE" -f 0001_roles_and_ledger.sql.template
--
-- Run 0000_migration_roles.sql.template first; this file creates only the migration ledger, owned by cv_migrator. It grants nothing to
-- any runtime role.
--
-- The ledger DDL below must stay identical to LEDGER_DDL in backend/db/runner/ledger.py. A test enforces this.

\set ON_ERROR_STOP on

-- The ledger is created by the bootstrap superuser, then handed to the owner role.
CREATE TABLE cv_analyzer.schema_migrations (
    filename    text PRIMARY KEY,
    sha256      text NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
    status      text NOT NULL CHECK (status IN ('applied', 'superseded')),
    replaced_by text,
    applied_at  timestamptz NOT NULL DEFAULT now(),
    applied_by  text NOT NULL DEFAULT session_user,
    CONSTRAINT schema_migrations_replacement CHECK ((status = 'superseded') = (replaced_by IS NOT NULL))
);

ALTER TABLE cv_analyzer.schema_migrations OWNER TO cv_migrator;
