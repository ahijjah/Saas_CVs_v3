        "responseBody": "={{\n{\n  \"success\": true,\n  \"token\": $(\"LOGIN – Create JWT\").first().json.token,\n  \"user\": $(\"LOGIN - Decide Result\").first().json.user_id,\n  \"cv_ingestion_mode\": $(\"get_ingestion_mode\").first().json.cv_ingestion_mode,\n  \"message\": \"Login successful\"\n}\n}}",
        "options": {}
      },
