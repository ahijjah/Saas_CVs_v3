    {
      "parameters": {
        "jsCode": "// n8n Code node (Run Once for Each Item)\n\nconst email = String($json.email || '').trim().toLowerCase();\nconst password = String($json.password_plain || '').trim();\n\nconst errors = [];\n\n// Required checks\nif (!email) errors.push({ field: \"email\", message: \"Email is required\" });\nif (!password) errors.push({ field: \"password\", message: \"Password is required\" });\n\n// Basic email shape check (frontend may do more)\nif (email && (!email.includes('@') || email.length < 6)) {\n  errors.push({ field: \"email\", message: \"Invalid email\" });\n}\n\n// Keep your existing rule\nif (password && password.length < 10) {\n  errors.push({ field: \"password\", message: \"Password too short (min 10 characters)\" });\n}\n\n// If validation failed → return unified error payload (do NOT throw)\nif (errors.length > 0) {\n  return [{\n    json: {\n      success: false,\n      code: \"LOGIN_VALIDATION_ERROR\",\n      message: \"Validation failed\",\n      errors,\n      http_status: 400\n    }\n  }];\n}\n\n// Valid → pass normalized values forward\nreturn [{\n  json: {\n    email,\n    password_plain: password\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "62af3c17-f725-4f84-8db7-ff0acca4ae80",
      "name": "LOGIN - Validate"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM cv_analyzer.auth_login($1, $2);",
        "options": {
          "queryReplacement": "={{ $json.email }},{{ $json.password_plain }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        832,
        160
      ],
      "id": "011bb0ab-abce-4c3b-bc16-7fafd8f0fee9",
      "name": "LOGIN - Verify Credentials",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "vUXV7XQLjuy24ou7",
          "name": "CV_postgress_account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $items(\"LOGIN - Verify Credentials\");\n\n// No valid row returned (wrong email OR wrong password)\nif (\n  rows.length === 0 ||\n  !rows[0].json ||\n  !rows[0].json.user_id\n) {\n  return [{\n    json: {\n      success: false,\n      code: \"LOGIN_INVALID_CREDENTIALS\",\n      message: \"Invalid email or password\",\n      http_status: 401\n    }\n  }];\n}\n\n// Valid login\nconst user = rows[0].json;\n\nreturn [{\n  json: {\n    success: true,\n    code: \"LOGIN_SUCCESS\",\n    message: \"Login successful\",\n    http_status: 200,\n    user_id: user.user_id,\n    tenant_id: user.tenant_id,\n    email: user.email,\n    role: user.role\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
