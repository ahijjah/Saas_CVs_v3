    {
      "parameters": {
        "jsCode": "const token = String($json.body?.token ?? \"\").trim();\nconst newPwd = String($json.body?.new_password ?? \"\").trim();\nconst confirmPwd = String($json.body?.confirm_password ?? \"\").trim();\n\nconst errors = [];\n\nif (!token) errors.push(\"token_required\");\nif (!newPwd) errors.push(\"new_password_required\");\nif (!confirmPwd) errors.push(\"confirm_password_required\");\n\nif (newPwd && newPwd.length < 9) errors.push(\"new_password_min_9_chars\");\nif (newPwd && confirmPwd && newPwd !== confirmPwd) errors.push(\"passwords_do_not_match\");\n\nreturn [{\n  json: {\n    token,\n    new_password: newPwd,\n    confirm_password: confirmPwd,\n    is_valid: errors.length === 0,\n    errors\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        112
      ],
      "id": "af74ab62-77b9-4ac1-96fb-d924558a6331",
