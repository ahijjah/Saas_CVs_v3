      "name": "Is Valid?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  SELECT user_id, tenant_id\n  FROM cv_analyzer.saas_users\n  WHERE status = 'active'\n    AND reset_token_hash = encode(digest($1::text, 'sha256'), 'hex')\n    AND reset_token_expires_at IS NOT NULL\n    AND reset_token_expires_at > now()\n),\nupd AS (\n  UPDATE cv_analyzer.saas_users\n  SET\n    password_hash = crypt($2::text, gen_salt('bf', 10)),\n    reset_token_hash = NULL,\n    reset_token_expires_at = NULL\n  WHERE user_id IN (SELECT user_id FROM u)\n  RETURNING user_id, tenant_id\n)\nSELECT\n  (SELECT COUNT(*) FROM u) AS token_valid_count,\n  (SELECT COUNT(*) FROM upd) AS updated_count,\n  (SELECT user_id FROM upd LIMIT 1) AS user_id;\n",
        "options": {
          "queryReplacement": "={{$json.token}}, {{$json.new_password}}"
        }
      },
