      "id": "e3d74a21-0c93-436e-b0c7-e73093849bda",
      "name": "API - Change Password",
      "webhookId": "560c57f5-428b-44de-acfd-e2e76831f687"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst errors = [];\n\nconst oldPwd = String(item.old_password ?? \"\").trim();\nconst newPwd = String(item.new_password ?? \"\").trim();\nconst confirmPwd = String(item.confirm_password ?? \"\").trim();\n\nif (!oldPwd) errors.push(\"old_password is required\");\nif (!newPwd) errors.push(\"new_password is required\");\nif (!confirmPwd) errors.push(\"confirm_password is required\");\n\nif (newPwd && newPwd.length < 9) errors.push(\"new_password must be at least 9 characters\");\nif (newPwd && confirmPwd && newPwd !== confirmPwd) errors.push(\"new_password and confirm_password do not match\");\nif (oldPwd && newPwd && oldPwd === newPwd) errors.push(\"new_password must be different from old_password\");\n\nreturn [\n  {\n    json: {\n      ...item,\n      is_valid: errors.length === 0,\n      errors,\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        112
      ],
      "id": "6421ce2a-add1-4393-bbf1-4efd79d672b4",
      "name": "Validate - Change Password Input"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  SELECT user_id, tenant_id, password_hash\n  FROM cv_analyzer.saas_users\n  WHERE tenant_id = $1::uuid\n    AND user_id = $2::uuid\n    AND status = 'active'\n),\nv AS (\n  SELECT\n    CASE\n      WHEN (SELECT COUNT(*) FROM u) = 0 THEN false\n      ELSE crypt($3, (SELECT password_hash FROM u)) = (SELECT password_hash FROM u)\n    END AS ok\n),\nupd AS (\n  UPDATE cv_analyzer.saas_users\n  SET\n    password_hash = crypt($4, gen_salt('bf', 10))\n  WHERE tenant_id = $1::uuid\n    AND user_id = $2::uuid\n    AND (SELECT ok FROM v) = true\n  RETURNING user_id\n)\nSELECT\n  (SELECT ok FROM v) AS old_password_ok,\n  (SELECT COUNT(*) FROM upd) AS updated_count;\n",
        "options": {
          "queryReplacement": "={{ $json.tenant_id }}, {{ $json.user_id }}, {{ $json.old_password }}, {{ $json.new_password }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
