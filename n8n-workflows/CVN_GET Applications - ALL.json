    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nreturn rows.map(r => ({\n  json: {\n    id: r.application_code || r.application_id, // what you show in UI\n    application_id: r.application_id,           // optional (hidden)\n    candidate_name: r.candidate_name,\n    score: Number(r.score || 0),\n    status: r.status,\n    applied_date: r.applied_date,\n    summary: r.summary || ''\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        0
      ],
      "id": "63ef0623-46f1-4aab-bce6-3575d657c4f9",
      "name": "shape response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  a.application_id,\n  a.candidate_name,\n  a.decision AS status,\n  COALESCE(a.final_score, 0) AS score,\n  to_char(a.received_at::date, 'YYYY-MM-DD') AS applied_date,\n  COALESCE(s.evaluation_notes, '') AS summary\nFROM cv_analyzer.job_applications a\nLEFT JOIN LATERAL (\n  SELECT\n    evaluation_notes\n  FROM cv_analyzer.job_application_scores s\n  WHERE s.application_id = a.application_id\n    AND s.tenant_id = a.tenant_id\n  ORDER BY s.scored_at DESC\n  LIMIT 1\n) s ON true\nWHERE a.job_id = $1\n  AND a.tenant_id = $2\nORDER BY a.received_at DESC;\n",
        "options": {
          "queryReplacement": "={{ $json.Job_id }}, {{ $json.tenant_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
