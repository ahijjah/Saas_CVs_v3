        "jsCode": "const p = $json.payload || {};\n\nif (!p.sub || !p.tenant_id) {\n  return [{ json: { error: 'Invalid JWT payload', statusCode: 401 } }];\n}\n\nreturn [{\n  json: {\n    user_id: p.sub,\n    tenant_id: p.tenant_id,\n    email: p.email,\n    role: p.role\n  }\n}];\n"
      },
