    {
      "parameters": {
        "jsCode": "// If Postgres returns 0 rows, n8n may still pass an empty item depending on config.\n// We enforce a clear output either way.\n\nconst row = $json;\n\nif (!row || !row.user_id) {\n  return [{\n    json: {\n      error: 'User not active or not found',\n      statusCode: 403\n    }\n  }];\n}\n\nreturn [{ json: row }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        176
      ],
      "id": "e86fe08d-7ff4-4b6a-b763-5a005b58c3c1",
      "name": "Validate Active User Result"
    },
    {
      "parameters": {
        "jsCode": "// When \"Continue On Fail\" is ON, failed JWT verify returns an item with error info.\n// We convert it to a standard 401 response.\n\nif ($json.errorMessage || $json.error) {\n  return [{\n    json: {\n      error: 'Invalid or expired token',\n      statusCode: 401\n    }\n  }];\n}\n\n// Success: JWT node returns { payload: {...} }\nreturn [{ json: $json }];\n"
      },
      "type": "n8n-nodes-base.code",
