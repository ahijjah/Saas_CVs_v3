    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  t.tenant_id,\n  t.tenant_name,\n  t.tenant_code,\n  t.status,\n  t.created_at,\n  (SELECT COUNT(*) FROM cv_analyzer.saas_users u WHERE u.tenant_id = t.tenant_id)::int AS users_count,\n  (SELECT COUNT(*) FROM cv_analyzer.job_posts j WHERE j.tenant_id = t.tenant_id)::int AS jobs_count,\n  (SELECT COUNT(*) FROM cv_analyzer.job_applications a WHERE a.tenant_id = t.tenant_id)::int AS applications_count\nFROM cv_analyzer.saas_tenants t\nWHERE\n  ($1 = '' OR t.status = $1)\n  AND (\n    $2 = '' OR\n    t.tenant_name ILIKE '%' || $2 || '%' OR\n    t.tenant_code ILIKE '%' || $2 || '%'\n  )\nORDER BY t.created_at DESC\nLIMIT $3 OFFSET $4;\n",
        "options": {
          "queryReplacement": "={{ $('Validate + Normalize Query').item.json.status }},{{ $('Validate + Normalize Query').item.json.search }} ,{{ $('Validate + Normalize Query').item.json.limit }} , {{ $('Validate + Normalize Query').item.json.offset }}"
        }
