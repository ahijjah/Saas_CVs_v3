    {
      "parameters": {
        "jsCode": "let page = parseInt($json.page, 10);\nlet limit = parseInt($json.limit, 10);\n\nif (!Number.isFinite(page) || page < 1) page = 1;\nif (!Number.isFinite(limit) || limit < 1) limit = 20;\nif (limit > 100) limit = 100;\n\nconst search = String($json.search || \"\").trim();\nconst statusRaw = String($json.status || \"\").trim().toLowerCase();\nconst status = [\"active\",\"suspended\"].includes(statusRaw) ? statusRaw : \"\";\n\nconst offset = (page - 1) * limit;\n\nreturn [{\n  json: {\n    ...$json,\n    page,\n    limit,\n    offset,\n    search,\n    status\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -96
      ],
      "id": "8f71ec47-d32d-4faa-b8cf-fbb1e18857ec",
      "name": "Validate + Normalize Query"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::int AS total\nFROM cv_analyzer.saas_tenants t\nWHERE\n  ($1 = '' OR t.status = $1)\n  AND (\n    $2 = '' OR\n    t.tenant_name ILIKE '%' || $2 || '%' OR\n    t.tenant_code ILIKE '%' || $2 || '%'\n  );\n",
        "options": {
          "queryReplacement": "={{$json.status}}, {{$json.search}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
