        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT COUNT(*) FROM cv_analyzer.saas_tenants) AS total_tenants,\n  (SELECT COUNT(*) FROM cv_analyzer.saas_tenants WHERE status = 'active') AS active_tenants,\n  (SELECT COUNT(*) FROM cv_analyzer.saas_users) AS total_users,\n  (SELECT COUNT(*) FROM cv_analyzer.job_posts) AS total_jobs,\n  (SELECT COUNT(*) FROM cv_analyzer.job_applications) AS total_applications,\n  (SELECT COUNT(*) FROM cv_analyzer.job_applications WHERE received_at >= CURRENT_DATE) AS applications_today,\n  (SELECT COUNT(*) FROM cv_analyzer.email_ingest_log \n   WHERE status != 'success' \n   AND received_at >= NOW() - INTERVAL '24 hours') AS failed_ingest_24h;\n",
