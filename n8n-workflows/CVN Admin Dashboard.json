        "query": "SELECT \n    t.tenant_id,\n    t.tenant_name,\n    t.tenant_code,\n    t.status,\n    t.created_at,\n    (SELECT COUNT(*) FROM cv_analyzer.saas_users u WHERE u.tenant_id = t.tenant_id)::int AS users_count,\n    (SELECT COUNT(*) FROM cv_analyzer.job_posts j WHERE j.tenant_id = t.tenant_id)::int AS jobs_count,\n    (SELECT COUNT(*) FROM cv_analyzer.job_applications a WHERE a.tenant_id = t.tenant_id)::int AS applications_count\nFROM cv_analyzer.saas_tenants t\nORDER BY t.created_at DESC;\n",
