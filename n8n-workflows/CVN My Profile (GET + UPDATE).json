      "id": "f62eedbb-9f8f-4f4e-9588-b2dfa249bb7d",
      "name": "RESP - My Profile"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst tenant_id = item.tenant_id;\nconst user_id = item.user_id;\n\nif (!tenant_id || !user_id) {\n  throw new Error(\"Missing tenant_id or user_id\");\n}\n\nconst clean = (v) => {\n  if (v === undefined || v === null) return undefined;\n  if (typeof v !== \"string\") return v;\n  const s = v.trim();\n  if (s === \"\" || s === \"undefined\" || s === \"null\") return undefined;\n  return s;\n};\n\n// ✅ map from your actual keys\nconst mapped = {\n  tenant_name: clean(item.tenant_name),\n  admin_name: clean(item.Admin_name),                 // <-- capital A input\n  cv_ingestion_mode: clean(item.intake_method),       // <-- intake_method input\n  forwarding_email: clean(item.forwarding_email),\n};\n\nconst updates = {};\nfor (const k of [\"tenant_name\", \"admin_name\", \"cv_ingestion_mode\", \"forwarding_email\"]) {\n  if (mapped[k] !== undefined) updates[k] = mapped[k];\n}\n\nif (Object.keys(updates).length === 0) {\n  throw new Error(\"No allowed fields to update\");\n}\n\n// FORWARD rule\nif (updates.cv_ingestion_mode === \"FORWARD\" && !updates.forwarding_email) {\n  throw new Error(\"forwarding_email is required when cv_ingestion_mode = FORWARD\");\n}\n\nif (updates.cv_ingestion_mode && updates.cv_ingestion_mode !== \"FORWARD\") {\n  delete updates.forwarding_email;\n}\n\nreturn [{\n  json: {\n    tenant_id,\n    user_id,\n    ...updates,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        208
      ],
      "id": "2395a62a-310e-41ed-ba25-aa0a1dbdcf92",
      "name": "Validate - Profile Update"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 1) Update admin name\nUPDATE cv_analyzer.saas_users\nSET full_name = COALESCE(NULLIF('{{ $item(0).$node[\"Validate - Profile Update\"].json.admin_name || \"\" }}',''), full_name)\nWHERE tenant_id = '{{ $item(0).$node[\"Validate - Profile Update\"].json.tenant_id }}'::uuid\n  AND user_id   = '{{ $item(0).$node[\"Validate - Profile Update\"].json.user_id }}'::uuid;\n\n-- 2) Update tenant\nUPDATE cv_analyzer.saas_tenants\nSET\n  tenant_name = COALESCE(NULLIF('{{ $item(0).$node[\"Validate - Profile Update\"].json.tenant_name || \"\" }}',''), tenant_name),\n  cv_ingestion_mode = COALESCE(NULLIF('{{ $item(0).$node[\"Validate - Profile Update\"].json.cv_ingestion_mode || \"\" }}',''), cv_ingestion_mode)\nWHERE tenant_id = '{{ $item(0).$node[\"Validate - Profile Update\"].json.tenant_id }}'::uuid;\n\n-- 3) Update inbox email only if FORWARD\nUPDATE cv_analyzer.saas_inboxes\nSET inbox_email = COALESCE(NULLIF('{{ $item(0).$node[\"Validate - Profile Update\"].json.forwarding_email || \"\" }}',''), inbox_email)\nWHERE tenant_id = '{{ $item(0).$node[\"Validate - Profile Update\"].json.tenant_id }}'::uuid\n  AND '{{ $item(0).$node[\"Validate - Profile Update\"].json.cv_ingestion_mode || \"\" }}' = 'FORWARD';\n\n-- 4) Return profile\nSELECT\n  u.user_id,\n  u.tenant_id,\n  u.full_name AS admin_name,\n  u.email,\n  u.role,\n  t.tenant_name,\n  t.cv_ingestion_mode,\n  t.status AS tenant_status,\n  i.inbox_email AS forwarding_email\nFROM cv_analyzer.saas_users u\nJOIN cv_analyzer.saas_tenants t ON t.tenant_id = u.tenant_id\nLEFT JOIN cv_analyzer.saas_inboxes i ON i.tenant_id = u.tenant_id\nWHERE u.tenant_id = '{{ $item(0).$node[\"Validate - Profile Update\"].json.tenant_id }}'::uuid\n  AND u.user_id   = '{{ $item(0).$node[\"Validate - Profile Update\"].json.user_id }}'::uuid\nLIMIT 1;\n",
        "options": {}
      },
