    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  u.user_id,\n  u.tenant_id,\n  u.full_name AS admin_name,\n  u.email,\n  u.role,\n\n  t.tenant_name,\n  t.status AS tenant_status,\n\n  t.cv_ingestion_mode,\n  t.cv_ingestion_mode AS intake_method,      -- ✅ backward compatible for frontend\n\n  i.inbox_email AS forwarding_email          -- ✅ frontend-friendly name\n\nFROM cv_analyzer.saas_users u\nJOIN cv_analyzer.saas_tenants t\n  ON t.tenant_id = u.tenant_id\nLEFT JOIN cv_analyzer.saas_inboxes i\n  ON i.tenant_id = u.tenant_id\n\nWHERE u.tenant_id = '{{ $json.tenant_id }}'::uuid\n  AND u.user_id   = '{{ $json.user_id }}'::uuid\nLIMIT 1;\n",
        "options": {}
      },
