        "html": "=<!DOCTYPE html>\n<html>\n<head>\n<style>\n  .card { font-family: sans-serif; max-width: 500px; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }\n  .header { background-color: #1a202c; color: white; padding: 20px; text-align: center; }\n  .content { padding: 30px; line-height: 1.6; color: #2d3748; }\n  .status-badge { display: inline-block; background: #3182ce; color: white; padding: 6px 16px; border-radius: 50px; font-size: 12px; font-weight: 700; margin-bottom: 20px; text-transform: uppercase; }\n  .details-box { background: #f7fafc; border-left: 4px solid #3182ce; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0; }\n  .instruction-box { background: #fffaf0; border: 1px dashed #ed8936; padding: 15px; border-radius: 8px; margin-top: 20px; color: #744210; }\n  .button { display: inline-block; background-color: #3182ce; color: white; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: 600; margin-top: 15px; }\n  .footer { font-size: 11px; color: #a0aec0; text-align: center; padding: 20px; }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"header\">\n      <h2>AI970 CV Analyzer</h2>\n    </div>\n\n    <div class=\"content\">\n\n      <div class=\"status-badge\">Password Reset Request</div>\n\n      <p>Hello,</p>\n\n      <p>We received a request to reset your account password.</p>\n\n      <div class=\"details-box\">\n        <strong>Email:</strong> {{ $('Generate Reset Token').item.json.email }}<br>\n        <strong>Requested At:</strong> {{ DateTime.now().toFormat('ff') }}<br>\n        <strong>Link Expiry:</strong> 15 minutes\n      </div>\n\n      <div class=\"instruction-box\">\n        <strong>Next Step:</strong><br>\n        Click the button below to set a new password.\n      </div>\n\n      <a href=\"{{ $json.reset_link }}\" class=\"button\">\n        Reset Password\n      </a>\n\n      <p style=\"margin-top:25px;\">\n        If you did not request this password reset, you can safely ignore this email.\n      </p>\n\n    </div>\n\n    <div class=\"footer\">\n      Ref: {{ 'PWD-' + DateTime.now().toMillis() }}\n    </div>\n  </div>\n</body>\n</html>\n",
