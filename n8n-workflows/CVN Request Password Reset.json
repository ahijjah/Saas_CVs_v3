        "query": "UPDATE cv_analyzer.saas_users\nSET\n  reset_token_hash = encode(digest($2::text, 'sha256'), 'hex'),\n  reset_token_expires_at = $3::timestamp\nWHERE lower(email) = lower($1::text)\n  AND status = 'active'\nRETURNING user_id;\n",
        "options": {
          "queryReplacement": "={{$json.email}}, {{$json.reset_token}}, {{$json.reset_token_expires_at}}"
        }
