    {
      "parameters": {
        "jsCode": "const email = String($json.body?.email ?? \"\").trim().toLowerCase();\n\nconst errors = [];\nif (!email) errors.push(\"email_required\");\n\n// Simple but effective email format check\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nif (email && !emailRegex.test(email)) errors.push(\"email_invalid\");\n\nreturn [{\n  json: {\n    is_valid: errors.length === 0,\n    email,\n    errors,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
