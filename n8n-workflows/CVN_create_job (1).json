    {
      "parameters": {
        "jsCode": "// 1. Extract raw text from the LangChain/OpenAI output structure\nconst rawText = $input.first().json.output[0].content[0].text;\n\ntry {\n  // 2. Professional Clean: Remove markdown code blocks if the LLM included them\n  const cleanText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n  \n  // 3. Parse the JSON\n  const data = JSON.parse(cleanText);\n\n  // Helper: Convert arrays to comma-separated strings for standard DB text fields\n  const arrayToString = (arr) => (Array.isArray(arr) ? arr.join(', ') : '');\n\n  // 4. Validate Weights (Ensures they sum to 100 or provides defaults)\n  const weights = data.scoring_weights || {};\n  const totalWeight = Object.values(weights).reduce((a, b) => a + (Number(b) || 0), 0);\n\n  // Return the mapped object\n  return {\n    skills_required: arrayToString(data.skills?.required),\n    skills_preferred: arrayToString(data.skills?.preferred),\n    experience_min_years: parseInt(data.experience?.minimum_years) || 0,\n    experience_roles: arrayToString(data.experience?.relevant_roles),\n    experience_responsibilities: arrayToString(data.experience?.key_responsibilities),\n    education_level: data.education?.minimum_level || '',\n    education_fields: arrayToString(data.education?.fields_of_study),\n    certifications: arrayToString(data.certifications),\n    soft_skills: arrayToString(data.soft_skills),\n    domain_knowledge: arrayToString(data.domain_knowledge),\n    other_requirements: arrayToString(data.other_requirements),\n    // Map weights and ensure they are numbers\n    weight_skills: Number(weights.skills) || 0,\n    weight_experience: Number(weights.experience) || 0,\n    weight_education: Number(weights.education) || 0,\n    weight_certifications: Number(weights.certifications) || 0,\n    weight_soft_skills: Number(weights.soft_skills) || 0,\n    weight_domain_knowledge: Number(weights.domain_knowledge) || 0,\n    weight_other_requirements: Number(weights.other_requirements) || 0,\n    // Add a flag if weights were invalid (useful for a Filter node later)\n    weights_valid: totalWeight === 100\n  };\n\n} catch (error) {\n  // Catching parsing errors to prevent the whole workflow from crashing\n  throw new Error(`Failed to parse LLM output. Raw text was: ${rawText}. Error: ${error.message}`);\n}"
      },
