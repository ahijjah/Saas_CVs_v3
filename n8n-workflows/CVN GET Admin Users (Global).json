      "id": "81e18223-2ba7-4b56-af27-92f0e0f6d896",
      "name": "WH - Admin Users List",
      "webhookId": "c019e665-0220-401a-ac93-e75d0869e0df"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (\n  SELECT $1::jsonb AS v\n)\nSELECT COUNT(*)::int AS total\nFROM cv_analyzer.saas_users u\nJOIN cv_analyzer.saas_tenants t ON t.tenant_id = u.tenant_id\nCROSS JOIN p\nWHERE\n  (COALESCE(p.v->>'status','') = '' OR u.status = (p.v->>'status'))\n  AND (COALESCE(p.v->>'role','') = '' OR LOWER(u.role) = LOWER(p.v->>'role'))\n  AND (\n    COALESCE(p.v->>'search','') = '' OR\n    u.email ILIKE '%' || (p.v->>'search') || '%' OR\n    COALESCE(u.full_name,'') ILIKE '%' || (p.v->>'search') || '%'\n  )\n  AND (\n    COALESCE(p.v->>'tenant','') = '' OR\n    t.tenant_name ILIKE '%' || (p.v->>'tenant') || '%' OR\n    t.tenant_code ILIKE '%' || (p.v->>'tenant') || '%'\n  );\n",
        "options": {
          "queryReplacement": "={{ [ {   status: String($json.status ?? ''),   role: String($json.role ?? ''),   search: String($json.search ?? ''),   tenant: String($json.tenant ?? '') } ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1168,
        -96
      ],
      "id": "db2d5a3f-93d6-4f00-b2bb-e518346f1dc3",
      "name": "DB - Users Total Count",
      "credentials": {
        "postgres": {
          "id": "vUXV7XQLjuy24ou7",
          "name": "CV_postgress_account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (\n  SELECT $1::jsonb AS v\n)\nSELECT\n  u.user_id,\n  u.email,\n  u.full_name,\n  u.role,\n  u.status,\n  u.created_at,\n  u.last_login_at,\n  u.tenant_id,\n  t.tenant_name,\n  t.tenant_code\nFROM cv_analyzer.saas_users u\nJOIN cv_analyzer.saas_tenants t ON t.tenant_id = u.tenant_id\nCROSS JOIN p\nWHERE\n  (COALESCE(p.v->>'status','') = '' OR u.status = (p.v->>'status'))\n  AND (COALESCE(p.v->>'role','') = '' OR LOWER(u.role) = LOWER(p.v->>'role'))\n  AND (\n    COALESCE(p.v->>'search','') = '' OR\n    u.email ILIKE '%' || (p.v->>'search') || '%' OR\n    COALESCE(u.full_name,'') ILIKE '%' || (p.v->>'search') || '%'\n  )\n  AND (\n    COALESCE(p.v->>'tenant','') = '' OR\n    t.tenant_name ILIKE '%' || (p.v->>'tenant') || '%' OR\n    t.tenant_code ILIKE '%' || (p.v->>'tenant') || '%'\n  )\nORDER BY u.created_at DESC\nLIMIT $2::int OFFSET $3::int;\n",
        "options": {
          "queryReplacement": "={{ [\n  {\n    status: String($json.status ?? ''),\n    role: String($json.role ?? ''),\n    search: String($json.search ?? ''),\n    tenant: String($json.tenant ?? '')\n  },\n  Number($json.limit ?? 20),\n  Number($json.offset ?? 0)\n] }}"
        }
      },
