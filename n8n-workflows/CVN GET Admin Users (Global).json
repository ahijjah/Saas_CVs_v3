        "jsCode": "const ctx = $items(\"Validate + Normalize Query\")[0].json;\n\nconst total = $items(\"DB - Users Total Count\")[0].json.total;\nconst users = $items(\"DB - Users Page\").map(i => i.json);\n\nreturn [{\n  json: {\n    page: ctx.page,\n    limit: ctx.limit,\n    total,\n    total_pages: Math.ceil(total / ctx.limit),\n    users\n  }\n}];\n"
