    {
      "parameters": {
        "jsCode": "const safeStr = (v) => (v === null || v === undefined) ? '' : String(v);\n\nlet page = parseInt($json.page, 10);\nlet limit = parseInt($json.limit, 10);\n\nif (!Number.isFinite(page) || page < 1) page = 1;\nif (!Number.isFinite(limit) || limit < 1) limit = 20;\nif (limit > 100) limit = 100;\n\nconst offset = (page - 1) * limit;\n\nconst search = safeStr($json.search).trim();\nconst tenant = safeStr($json.tenant).trim();\n\nconst role = safeStr($json.role).trim().toLowerCase();      // allow any role value\nconst statusRaw = safeStr($json.status).trim().toLowerCase();\nconst status = ['active', 'disabled'].includes(statusRaw) ? statusRaw : '';\n\nreturn [{\n  json: {\n    ...$json,\n    page,\n    limit,\n    offset,\n    search,\n    tenant,\n    role,     // always string\n    status    // always string\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -96
      ],
      "id": "427668fb-5e10-4769-96c2-ec42afff0e85",
